#!/usr/bin/env ruby

processes = [
  Process.spawn("./bin/rails", "server", *ARGV),
  Process.spawn("bundle", "exec", "solid_objects", "start")
]

shutdown = lambda do |signal|
  processes.each do |process_id|
    Process.kill(signal, process_id)
  rescue Errno::ESRCH
  end
end

%w[INT TERM].each do |signal|
  Signal.trap(signal) do
    shutdown.call(signal)
    exit
  end
end

finished_process_id, status = Process.wait2
processes.delete(finished_process_id)
shutdown.call("TERM")
processes.each { |process_id| Process.wait(process_id) }
exit(status.exitstatus || 1)
